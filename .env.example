# ============================================================
# 复制本文件为 .env 后填写（.env 已在 .gitignore 中，不会被提交）
# ============================================================

# ---------- 游戏版本 ----------
# latest = 每次采集时自动取官方最新版本；也可写死，如 16.19.1
GAME_VERSION=latest

# ---------- 大模型（用于路由分类 + 生成答案，OpenAI 兼容协议） ----------
# 常见填写方式：
#   DeepSeek: LLM_BASE_URL=https://api.deepseek.com/v1       LLM_MODEL=deepseek-chat
#   通义千问: LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
#   智谱:     LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_MODEL=glm-4-flash
#   OpenAI:   LLM_BASE_URL=https://api.openai.com/v1         LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2

# ---------- 嵌入模型（把文本变成向量，OpenAI 兼容协议） ----------
# 讲究：必须选中文效果好的模型；换模型必须重建索引（见 README）
#
# 百度千帆（本项目默认，注意向量接口是 /embeddings 不是 /chat/completions）：
#   EMBED_BASE_URL=https://qianfan.baidubce.com/v2
#   EMBED_MODEL=qwen3-embedding-0.6b   # 千问，1024 维，便宜；也可 qwen3-embedding-4b（2560 维，更好）
#   ⚠️ 千帆的模型名必须全小写，写成 Qwen3-Embedding-0.6B 会报 no_such_model
#
# 其它可选：
#   通义: EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  EMBED_MODEL=text-embedding-v3
#   智谱: EMBED_BASE_URL=https://open.bigmodel.cn/api/paas/v4  EMBED_MODEL=embedding-3
#   OpenAI: EMBED_BASE_URL=https://api.openai.com/v1  EMBED_MODEL=text-embedding-3-small
EMBED_BASE_URL=https://qianfan.baidubce.com/v2
EMBED_API_KEY=
EMBED_MODEL=qwen3-embedding-0.6b
# 千帆限制：单次请求文本数 ≤ 16（tao-8k 除外）
EMBED_BATCH_SIZE=16

# ---------- 联网搜索兜底（回答最新版本改动时用） ----------
# 可选：tavily / serper / bocha / none（none = 关闭联网）
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
# 搜索结果本地缓存时长（秒），避免重复计费
SEARCH_CACHE_TTL=86400

# ---------- 检索参数 ----------
TOP_K=4
# 余弦相似度低于该值 => 判定"本地知识库没有"，触发联网兜底
SCORE_THRESHOLD=0.35
CHUNK_SIZE=600
CHUNK_OVERLAP=80
